{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<section class="flex flex-col items-center p-4 md:p-6 min-h-screen w-full gap-6 mb-12">

    

    <div class="container mx-auto max-w-3xl p-6 md:p-8 bg-white rounded-lg shadow">

        {# ─── Cálculo de iniciales con fallbacks ─── #}
        {% set initials = '' %}
        {% if user.firstName %}
            {% set initials = initials ~ user.firstName|first|upper %}
        {% endif %}
        {% if user.lastName %}
            {% set initials = initials ~ user.lastName|first|upper %}
        {% endif %}
        {% if initials is empty and user.email %}
            {% set initials = user.email|first|upper %}
        {% endif %}
        {% if initials is empty %}
            {% set initials = '?' %}
        {% endif %}

        {% set fullName = (user.firstName ~ ' ' ~ user.lastName)|trim %}
        {% if fullName is empty %}
            {% set fullName = user.email %}
        {% endif %}

        <div class="flex flex-col md:flex-row md:items-start gap-8">

            {# ─── Avatar / Iniciales ─── #}
            <div class="flex justify-center md:order-last md:flex-shrink-0">
                <div class="relative w-28 h-28 md:w-32 md:h-32">

                    {# Fondo azul con iniciales: siempre visible debajo #}
                    <div class="absolute inset-0 w-full h-full rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-4xl shadow">
                        {{ initials }}
                    </div>

                    {# Si hay avatar, se superpone encima #}
                    {% if user.avatarUrl %}
                        <img
                            src="{{ user.avatarUrl }}"
                            alt="{{ fullName }}"
                            class="absolute inset-0 w-full h-full rounded-full object-cover border-4 border-gray-100 shadow"
                            onerror="this.style.display='none'"
                        >
                    {% endif %}

                </div>
            </div>

            {# ─── Información del perfil ─── #}
            <div class="flex-1 w-full">

                <div class="text-center md:text-left mb-6">
                    <h2 class="text-2xl font-semibold text-gray-800">
                        {{ fullName }}
                    </h2>
                </div>

                <dl class="divide-y divide-gray-100">

                    <div class="flex justify-between py-3 gap-4">
                        <dt class="text-gray-500 font-medium">Prénom</dt>
                        <dd class="text-gray-800 text-right">{{ user.firstName ?: '—' }}</dd>
                    </div>

                    <div class="flex justify-between py-3 gap-4">
                        <dt class="text-gray-500 font-medium">Nom</dt>
                        <dd class="text-gray-800 text-right">{{ user.lastName ?: '—' }}</dd>
                    </div>

                    <div class="flex justify-between py-3 gap-4">
                        <dt class="text-gray-500 font-medium">Sexe</dt>
                        <dd class="text-gray-800 text-right">{{ user.sex ? user.sex.value|capitalize : '—' }}</dd>
                    </div>

                    <div class="flex justify-between py-3 gap-4">
                        <dt class="text-gray-500 font-medium">Email</dt>
                        <dd class="text-gray-800 text-right break-all">{{ user.email ?: '—' }}</dd>
                    </div>

                </dl>
            </div>

        </div>

        {# ─── Acciones ─── #}
        <div class="flex flex-col sm:flex-row sm:justify-end gap-3 mt-8 pt-6 border-t border-gray-200">
            <a href="{{ path('app_user_edit', {'id': user.id}) }}"
               class="px-5 py-2.5 bg-blue-600 text-white text-center rounded-lg hover:bg-blue-700 transition font-medium">
               Modifier le profil
            </a>
        </div>

    </div>

</section>
{% endblock %}