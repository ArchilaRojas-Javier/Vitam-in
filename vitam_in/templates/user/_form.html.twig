
    <div class="container mx-auto max-w-2xl p-6 md:p-8 ">

        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            {# Email (solo lectura) #}
            <div>
                {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.email, {'attr': {
                    'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-100 text-gray-500 cursor-not-allowed'
                }}) }}
                {{ form_errors(form.email) }}
            </div>

            {# Nombre #}
            <div>
                {{ form_label(form.firstName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.firstName, {'attr': {
                    'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none'
                }}) }}
                {{ form_errors(form.firstName) }}
            </div>

            {# Apellido #}
            <div>
                {{ form_label(form.lastName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.lastName, {'attr': {
                    'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none'
                }}) }}
                {{ form_errors(form.lastName) }}
            </div>

            {# Sexo #}
            <div>
                {{ form_label(form.sex, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.sex, {'attr': {
                    'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none'
                }}) }}
                {{ form_errors(form.sex) }}
            </div>

            {# Acciones #}
            <div class="flex flex-col sm:flex-row sm:justify-between gap-3 pt-6 border-t border-gray-200">
                <a href="{{ path('app_user_profile') }}"
                   class="px-5 py-2.5 bg-gray-200 text-gray-700 text-center rounded-lg hover:bg-gray-300 transition font-medium">
                    Annuler
                </a>
                <button type="submit"
                        class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
                    Enregistrer
                </button>
            </div>

        {{ form_end(form) }}

    </div>
