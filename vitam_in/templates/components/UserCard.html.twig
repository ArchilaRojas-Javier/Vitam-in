{% if this.fullName %}
	<div
		class="container flex items-center justify-between bg-[#fffff] m-6 p-2"
	>
		{# Côté gauche : nom  #}
		<div class="text-base text-[#6E6F6F]">
			<p class="text-2xl">Bonjour,</p>
			<span>{{ this.fullName }}</span>
		</div>

		{# Côté droit : avatar #}
		{# ─── Avatar / Iniciales ─── #}
            <div class="flex justify-center md:order-last md:flex-shrink-0">
                <div class="relative w-24 h-24 md:w-32 md:h-32">

                    {# Fondo azul con iniciales: siempre visible debajo #}
                    <div class="absolute inset-0 w-full h-full rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-4xl shadow">
                        {{ this.initials }}
                    </div>

                    {# Si hay avatar, se superpone encima #}
                    {% if this.avatarUrl %}
                        <img
                            src="{{ this.avatarUrl }}"
                            alt="{{ this.fullName }}"
                            class="absolute inset-0 w-full h-full rounded-full object-cover border-4 border-gray-100 shadow"
                            onerror="this.style.display='none'"
                        >
                    {% endif %}

                </div>
            </div>
	</div>

{% endif %} 

